{
  "$schema": "https://opencode.ai/config.json",
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },

  "autoupdate": true,

  "permission": {
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "codesearch": "allow",
    "lsp": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "git *": "allow",
      "git commit *": "ask",
      "git push *": "ask",
      "git checkout -b *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "git reset *": "ask",
      "rm *": "ask",
      "mv *": "ask",
      "cp *": "ask"
    }
  }
}
