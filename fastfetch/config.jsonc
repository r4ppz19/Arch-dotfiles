// Inspired by Catnap
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "blue",
      "2": "blue"
    }
  },
  "display": {
    "separator": "",
    "key": {
      "width": 12
    }
  },
  "modules": [
    {
      // draw borders first to make colors of left and right border consistant
      "key": " user",
      "type": "title",
      "format": "{user-name}",
      "keyColor": "31"
    },
    {
      "key": "{icon} distro",
      "type": "os",
      "keyColor": "34"
    },
    {
      "key": " kernel",
      "type": "kernel",
      "keyColor": "35"
    },
    {
      "key": "󰇄 desktop",
      "type": "de",
      "keyColor": "36"
    },
    {
      "key": " term",
      "type": "terminal",
      "keyColor": "31"
    },
    {
      "key": " shell",
      "type": "shell",
      "keyColor": "32"
    },
    {
      "key": "󰍛 cpu",
      "type": "cpu",
      "keyColor": "33"
    },
    {
      "key": "󰉉 disk",
      "type": "disk",
      "folders": "/",
      "keyColor": "34"
    },
    {
      "key": " memory",
      "type": "memory",
      "keyColor": "35"
    },
    {
      "key": " colors",
      "type": "colors",
      "symbol": "circle",
      "keyColor": "39"
    }
  ]
}
